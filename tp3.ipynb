   "cell_type": "code",
   "execution_count": 35,
   "id": "278c6b73",
   "metadata": {},
   "outputs": [],
   "source": [
    "horaire_hours['avg_open_hours'] = horaire_hours[day_cols].mean(axis=1)"
   ]
  },
